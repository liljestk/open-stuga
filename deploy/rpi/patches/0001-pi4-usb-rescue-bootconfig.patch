diff --git a/image/gpt/ab_userdata/pre-image.sh b/image/gpt/ab_userdata/pre-image.sh
index 557761a..9e910ed 100755
--- a/image/gpt/ab_userdata/pre-image.sh
+++ b/image/gpt/ab_userdata/pre-image.sh
@@ -30,2 +30,12 @@ VERITY_ARGS_SYSTEM="\
+# Keep a complete first-partition payload as the normal Pi 4 USB boot.
+# Do not place autoboot.txt beside it: redirecting partition 1 back to itself
+# loops in firmware, while redirects to later GPT FAT partitions are not
+# reliable across the USB-SATA bridges supported by the appliance.
+rescue_boot_dir="${fs}/boot/rescue-firmware"
+rm -rf -- "${rescue_boot_dir}"
+install -d -m 0755 "${rescue_boot_dir}"
+cp -a "${fs}/boot/firmware/." "${rescue_boot_dir}/"
+printf 'a\n' > "${rescue_boot_dir}/stugu-active-slot"
+
 # Set up the partition layout for tryboot support. Partition numbering
 # relates directly to the layout in genimage.cfg.in
