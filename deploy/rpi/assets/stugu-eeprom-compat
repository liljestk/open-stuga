#!/bin/bash
set -Eeuo pipefail

readonly desired_boot_order=0xf14
readonly desired_self_update=1
readonly desired_usb_power_off=0

current="$(rpi-eeprom-config)"
value_for() {
  sed -n "s/^$1=//p" <<<"$current" | tail -n 1
}

if [[ "$(value_for BOOT_ORDER)" == "$desired_boot_order" &&
  "$(value_for ENABLE_SELF_UPDATE)" == "$desired_self_update" &&
  "$(value_for USB_MSD_PWR_OFF_TIME)" == "$desired_usb_power_off" ]]; then
  echo "Stugu EEPROM USB compatibility settings are already active"
  exit 0
fi

touch /run/stugu-eeprom-incompatible
echo "Stugu EEPROM USB compatibility settings differ; recovery-class local maintenance is required" >&2
echo "The appliance will not mutate EEPROM during ordinary startup or host update." >&2
