#!/bin/bash
set -Eeuo pipefail

readonly desired_boot_order=0xf14
readonly desired_self_update=1
readonly desired_usb_power_off=0

current="$(rpi-eeprom-config)"
value_for() {
  sed -n "s/^$1=//p" <<<"$current" | tail -n 1
}

if [[ "$(value_for BOOT_ORDER)" == "$desired_boot_order" &&
  "$(value_for ENABLE_SELF_UPDATE)" == "$desired_self_update" &&
  "$(value_for USB_MSD_PWR_OFF_TIME)" == "$desired_usb_power_off" ]]; then
  echo "Stugu EEPROM USB compatibility settings are already active"
  exit 0
fi

temporary_config="$(mktemp /run/stugu-eeprom-config.XXXXXX)"
cleanup() {
  rm -f "$temporary_config"
}
trap cleanup EXIT

awk '
  !/^(BOOT_ORDER|ENABLE_SELF_UPDATE|USB_MSD_PWR_OFF_TIME)=/
' <<<"$current" > "$temporary_config"
cat >> "$temporary_config" <<EOF
ENABLE_SELF_UPDATE=$desired_self_update
BOOT_ORDER=$desired_boot_order
USB_MSD_PWR_OFF_TIME=$desired_usb_power_off
EOF

rpi-eeprom-config --apply "$temporary_config"
echo "Scheduled the current stable EEPROM with Stugu USB compatibility settings"
