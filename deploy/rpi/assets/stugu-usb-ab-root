#!/bin/sh
# Create A/B aliases for the direct-boot rescue partition while initramfs waits
# for /dev/disk/by-slot/active/system. USB needs firmware-topology resolution;
# SD needs this helper because the rescue partition is named bootconfig rather
# than boot_a or boot_b, which the upstream MMC slot mapper expects.

set -u

[ -e /run/stugu-usb-ab-ready ] && exit 0

proc_root="${STUGU_PROC_ROOT:-/proc}"
sys_root="${STUGU_SYS_ROOT:-/sys}"
dev_root="${STUGU_DEV_ROOT:-/dev}"
slot_root="${STUGU_SLOT_ROOT:-${dev_root}/disk/by-slot}"

read_dt_u32() {
  # shellcheck disable=SC2046,SC2312
  set -- $(od -An -tu1 -N4 "$1" 2>/dev/null)
  [ "$#" -eq 4 ] || return 1
  echo $(( $1 * 16777216 + $2 * 65536 + $3 * 256 + $4 ))
}

bootloader_dt="${proc_root}/device-tree/chosen/bootloader"
boot_mode="$(read_dt_u32 "${bootloader_dt}/boot-mode")" || exit 0
case "$boot_mode" in
  1)
    boot_disk="mmcblk0"
    partition_separator="p"
    ;;
  4|5)
    # The resolver is quiet while USB discovery is still in progress.
    # initramfs calls local-block scripts again until the disk is available.
    boot_disk="$(STUGU_PROC_ROOT="$proc_root" STUGU_SYS_ROOT="$sys_root" \
      /usr/bin/stugu-usb-bootdev 2>/dev/null)" || exit 0
    partition_separator=""
    ;;
  *) exit 0 ;;
esac

boot_partition="$(read_dt_u32 "${bootloader_dt}/partition")" || exit 0
[ "$boot_partition" -gt 0 ] || exit 0

boot_device="${dev_root}/${boot_disk}${partition_separator}${boot_partition}"
[ -b "$boot_device" ] || exit 0
boot_label="$(blkid -s PARTLABEL -o value "$boot_device" 2>/dev/null)" || exit 0

bootconfig_active_suffix() {
  selected_suffix="a"
  marker_file="${STUGU_BOOTCONFIG_SLOT_FILE:-}"
  marker_mount=""

  if [ -z "$marker_file" ]; then
    marker_mount="${STUGU_BOOTCONFIG_MOUNT:-/run/stugu-bootconfig}"
    if mkdir -p "$marker_mount" &&
      mount -t vfat -o ro "$boot_device" "$marker_mount" 2>/dev/null; then
      marker_file="${marker_mount}/stugu-active-slot"
    else
      marker_mount=""
    fi
  fi

  if [ -r "$marker_file" ]; then
    requested_suffix=""
    IFS= read -r requested_suffix < "$marker_file" || :
    case "$requested_suffix" in
      a|b) selected_suffix="$requested_suffix" ;;
      *) echo "Stugu: ignoring invalid USB slot marker" >&2 ;;
    esac
  fi

  if [ -n "$marker_mount" ]; then
    umount "$marker_mount" 2>/dev/null ||
      echo "Stugu: could not unmount temporary bootconfig view" >&2
  fi

  printf '%s\n' "$selected_suffix"
}

case "$boot_label" in
  bootconfig)
    # Direct boot avoids firmware partition handoff failures on USB-SATA
    # bridges. A one-line marker selects the matching system slot; missing or
    # invalid markers fail closed to the factory A slot.
    active_suffix="$(bootconfig_active_suffix)"
    ;;
  boot_a)
    active_suffix="a"
    ;;
  boot_b)
    active_suffix="b"
    ;;
  *)
    exit 0
    ;;
esac

bootconfig_device=""
boot_a_device=""
boot_b_device=""
system_a_device=""
system_b_device=""
persistent_device=""

for partition_path in \
  "${sys_root}/class/block/${boot_disk}/${boot_disk}"*; do
  [ -r "${partition_path}/uevent" ] || continue
  partition_name="$(
    sed -n 's/^PARTNAME=//p' "${partition_path}/uevent" 2>/dev/null
  )"
  partition_device="${dev_root}/${partition_path##*/}"
  [ -b "$partition_device" ] || continue

  case "$partition_name" in
    bootconfig) bootconfig_device="$partition_device" ;;
    boot_a) boot_a_device="$partition_device" ;;
    boot_b) boot_b_device="$partition_device" ;;
    system_a) system_a_device="$partition_device" ;;
    system_b) system_b_device="$partition_device" ;;
    persistent) persistent_device="$partition_device" ;;
  esac
done

case "$active_suffix" in
  a)
    active_boot_device="$boot_a_device"
    active_system_device="$system_a_device"
    other_boot_device="$boot_b_device"
    other_system_device="$system_b_device"
    ;;
  b)
    active_boot_device="$boot_b_device"
    active_system_device="$system_b_device"
    other_boot_device="$boot_a_device"
    other_system_device="$system_a_device"
    ;;
esac

for required_device in \
  "$bootconfig_device" \
  "$active_boot_device" \
  "$other_boot_device" \
  "$active_system_device" \
  "$other_system_device" \
  "$persistent_device"; do
  [ -b "$required_device" ] || exit 0
done

mkdir -p "${slot_root}/active" "${slot_root}/other"
ln -sf "$bootconfig_device" "${slot_root}/bootconfig" || exit 0
ln -sf "$active_boot_device" "${slot_root}/active/boot" || exit 0
ln -sf "$active_system_device" "${slot_root}/active/system" || exit 0
ln -sf "$other_boot_device" "${slot_root}/other/boot" || exit 0
ln -sf "$other_system_device" "${slot_root}/other/system" || exit 0
ln -sf "$persistent_device" "${slot_root}/persistent" || exit 0

# initramfs uses klibc's deliberately small ln implementation. Verify every
# link before allowing the upstream fail-closed root guard to continue.
for link_spec in \
  "${slot_root}/bootconfig:$bootconfig_device" \
  "${slot_root}/active/boot:$active_boot_device" \
  "${slot_root}/active/system:$active_system_device" \
  "${slot_root}/other/boot:$other_boot_device" \
  "${slot_root}/other/system:$other_system_device" \
  "${slot_root}/persistent:$persistent_device"; do
  link_path="${link_spec%%:*}"
  link_target="${link_spec#*:}"
  [ -L "$link_path" ] || exit 0
  [ "$(readlink "$link_path" 2>/dev/null)" = "$link_target" ] || exit 0
done

: > /run/stugu-usb-ab-ready
message="Stugu: bound direct-boot disk ${boot_disk}, active slot ${active_suffix}"
echo "$message" >&2
if [ -w /dev/kmsg ]; then
  echo "$message" > /dev/kmsg 2>/dev/null || :
fi
