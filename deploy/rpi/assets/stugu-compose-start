#!/bin/bash
set -Eeuo pipefail

readonly project_dir=/opt/stugu
readonly state_dir=/persistent/stugu
readonly local_env="$state_dir/stugu.env"
readonly release_env="$project_dir/release.env"
readonly update_release_env="$state_dir/update-release/release-v3.env"
readonly known_good_env="$state_dir/update-release/known-good-v3.env"
readonly legacy_known_good_env="$state_dir/last-known-good.env"
readonly docker_config="$state_dir/docker-config"
readonly status_file="$state_dir/release-status"
readonly migration_health_authorization="$state_dir/migrations/.health-check-authorization"
readonly appliance_user=stugu
readonly lock_file=/run/lock/stugu-compose.lock

install -d -m 0750 -o "$appliance_user" -g "$appliance_user" "$state_dir"
install -d -m 0700 -o "$appliance_user" -g "$appliance_user" "$docker_config"
install -d -m 0750 -o "$appliance_user" -g "$appliance_user" \
  "$state_dir/backups" \
  "$state_dir/migrations" \
  "$state_dir/migrations/incoming" \
  "$state_dir/migrations/chunks" \
  "$state_dir/config" \
  "$state_dir/update-operations" \
  "$state_dir/update-release" \
  "$state_dir/secrets" \
  "$state_dir/secrets/apns" \
  "$state_dir/secrets/bug-report" \
  "$state_dir/secrets/cloudflare" \
  "$state_dir/secrets/r2" \
  "$state_dir/secrets/tapo-history-api" \
  "$state_dir/secrets/tapo-history-runner"

# Older OS slots keep using the unversioned candidate and known-good files.
# Contract 3 uses distinct names so an A/B rollback boots its own contract.

# The service starts as root, while migration commands run as stugu. Keep one
# shared inode so both callers coordinate through the same flock after boot.
touch "$lock_file"
chown root:"$appliance_user" "$lock_file"
chmod 0660 "$lock_file"

# Never boot application containers over a partially mutated migration. The
# receipt is a write-ahead journal; an operator must finish rollback before the
# service can expose SQLite, WAL sidecars, settings, or database names.
authorized_pending_id=""
if [[ -f "$migration_health_authorization" && ! -L "$migration_health_authorization" ]]; then
  authorized_boot_id=""
  candidate_id=""
  read -r authorized_boot_id candidate_id < "$migration_health_authorization" || true
  rm -f "$migration_health_authorization"
  current_boot_id="$(cat /proc/sys/kernel/random/boot_id)"
  if [[ "$authorized_boot_id" == "$current_boot_id"
    && "$candidate_id" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$ ]]; then
    authorized_pending_id="${candidate_id,,}"
  fi
fi
shopt -s nullglob
for migration_receipt in "$state_dir"/migrations/receipts/*.json; do
  if grep -Eq '"status"[[:space:]]*:[[:space:]]*"(apply-intent|applying|rolling-back)"' \
      "$migration_receipt"; then
    echo "Refusing to start over incomplete migration receipt: $migration_receipt" >&2
    echo "Run 'stuguctl migration status <id>' and 'stuguctl migration rollback <id>'." >&2
    exit 1
  fi
  if grep -Eq '"status"[[:space:]]*:[[:space:]]*"applied-pending-health-check"' \
      "$migration_receipt"; then
    receipt_id="$(basename "$migration_receipt" .json)"
    if [[ "${receipt_id,,}" != "$authorized_pending_id" ]]; then
      echo "Refusing to start over an uncommitted migration: $migration_receipt" >&2
      echo "Run 'stuguctl migration resume $receipt_id' after inspecting its health evidence." >&2
      exit 1
    fi
  fi
done

if [[ ! -e "$local_env" ]]; then
  install -m 0640 -o "$appliance_user" -g "$appliance_user" \
    "$project_dir/stugu.env.example" "$local_env"
fi

# Existing appliances keep their persistent environment across OS releases.
# Add target-only mount and updater defaults without changing operator values.
missing_appliance_settings=()
for setting in \
  "STUGA_MIGRATION_SETTINGS_DIRECTORY=/persistent/stugu" \
  "STUGA_MIGRATION_ENV_FILENAME=stugu.env" \
  "STUGA_UPDATE_COMPOSE_ENV_FILE=/persistent/stugu/stugu.env" \
  "STUGA_DOCKER_CONFIG_DIRECTORY=/persistent/stugu/docker-config" \
  "STUGA_COMPOSE_PROJECT_NAME=stugu" \
  "STUGA_BUG_REPORT_SECRET_DIR=/persistent/stugu/secrets/bug-report" \
  "BUG_REPORT_RELAY_URL=" \
  "STUGA_R2_SECRET_DIR=/persistent/stugu/secrets/r2"; do
  setting_name="${setting%%=*}"
  if ! grep -q "^${setting_name}=" "$local_env"; then
    missing_appliance_settings+=("$setting")
  fi
done
for setting_name in SYSTEM_UPDATE_REPOSITORY SYSTEM_UPDATE_IMAGE_PREFIX; do
  if [[ "$(grep -c "^${setting_name}=" "$project_dir/stugu.env.example")" -ne 1 ]]; then
    echo "Factory appliance settings contain an invalid $setting_name" >&2
    exit 1
  fi
  if ! grep -q "^${setting_name}=" "$local_env"; then
    missing_appliance_settings+=(
      "$(sed -n "/^${setting_name}=/p" "$project_dir/stugu.env.example")"
    )
  fi
done
if ! grep -q '^STUGA_GPIO_GID=' "$local_env" && [[ -c /dev/gpiochip0 ]]; then
  gpio_gid="$(stat --format=%g /dev/gpiochip0)"
  if [[ ! "$gpio_gid" =~ ^[0-9]+$ ]]; then
    echo "The gpiochip0 device has an invalid group id" >&2
    exit 1
  fi
  missing_appliance_settings+=("STUGA_GPIO_GID=$gpio_gid")
fi
if (( ${#missing_appliance_settings[@]} > 0 )); then
  temporary_env="$(mktemp "$state_dir/.stugu.env.XXXXXX")"
  cat "$local_env" > "$temporary_env"
  printf '\n# Target paths added by an appliance upgrade.\n' >> "$temporary_env"
  printf '%s\n' "${missing_appliance_settings[@]}" >> "$temporary_env"
  chown "$appliance_user:$appliance_user" "$temporary_env"
  chmod 0640 "$temporary_env"
  mv -f "$temporary_env" "$local_env"
fi

if [[ "$(grep -c '^SYSTEM_UPDATE_REPOSITORY=' "$local_env")" -ne 1
  || "$(grep -c '^SYSTEM_UPDATE_IMAGE_PREFIX=' "$local_env")" -ne 1 ]]; then
  echo "Appliance update repository and image prefix must each be configured once" >&2
  exit 1
fi
release_repository="$(sed -n 's/^SYSTEM_UPDATE_REPOSITORY=//p' "$local_env")"
image_prefix="$(sed -n 's/^SYSTEM_UPDATE_IMAGE_PREFIX=//p' "$local_env")"
if [[ ! "$release_repository" =~ ^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$
  || ! "$image_prefix" =~ ^ghcr\.io/[a-z0-9_.-]{1,100}/[a-z0-9_.-]{1,100}$ ]]; then
  echo "Appliance update repository or GHCR image prefix is invalid" >&2
  exit 1
fi
readonly release_repository image_prefix

# Appliance releases check GitHub daily and install stable releases during a
# quiet weekly window. An administrator's saved policy always wins.
if [[ ! -e "$state_dir/update-operations/settings.json" ]]; then
  temporary_settings="$(mktemp "$state_dir/update-operations/.settings.XXXXXX")"
  cat > "$temporary_settings" <<'EOF'
{
  "mode": "automatic",
  "includePrereleases": false,
  "checkIntervalHours": 24,
  "updateTime": "03:00",
  "updateDays": ["sun"],
  "timezone": "UTC"
}
EOF
  chown "$appliance_user:$appliance_user" "$temporary_settings"
  chmod 0640 "$temporary_settings"
  mv -f "$temporary_settings" "$state_dir/update-operations/settings.json"
fi

bootstrap_secret="$(sed -n 's/^LOCAL_AUTH_BOOTSTRAP_SECRET=//p' "$local_env" | tail -n 1)"
if [[ -z "$bootstrap_secret" ]]; then
  bootstrap_secret="$(
    dd if=/dev/urandom bs=32 count=1 status=none \
      | base64 -w0 \
      | tr '+/' '-_' \
      | tr -d '='
  )"
  if [[ ! "$bootstrap_secret" =~ ^[A-Za-z0-9_-]{43}$ ]]; then
    echo "Failed to generate the first-owner bootstrap secret" >&2
    exit 1
  fi

  temporary_env="$(mktemp "$state_dir/.stugu.env.XXXXXX")"
  bootstrap_setting_seen=0
  while IFS= read -r setting || [[ -n "$setting" ]]; do
    if [[ "$setting" == LOCAL_AUTH_BOOTSTRAP_SECRET=* ]]; then
      printf 'LOCAL_AUTH_BOOTSTRAP_SECRET=%s\n' "$bootstrap_secret"
      bootstrap_setting_seen=1
    else
      printf '%s\n' "$setting"
    fi
  done < "$local_env" > "$temporary_env"
  if (( bootstrap_setting_seen == 0 )); then
    printf 'LOCAL_AUTH_BOOTSTRAP_SECRET=%s\n' "$bootstrap_secret" >> "$temporary_env"
  fi
  chown "$appliance_user:$appliance_user" "$temporary_env"
  chmod 0640 "$temporary_env"
  mv -f "$temporary_env" "$local_env"
fi

if [[ ! -e "$state_dir/config/tapo-flow.json" ]]; then
  install -m 0640 -o "$appliance_user" -g "$appliance_user" \
    "$project_dir/apps/tapo-export-runner/flow.example.json" \
    "$state_dir/config/tapo-flow.json"
fi

while IFS= read -r -d '' source_file; do
  destination="$state_dir/config/${source_file#"$project_dir/config/"}"
  if [[ ! -e "$destination" ]]; then
    install -d -m 0750 -o "$appliance_user" -g "$appliance_user" \
      "$(dirname "$destination")"
    install -m 0640 -o "$appliance_user" -g "$appliance_user" \
      "$source_file" "$destination"
  fi
done < <(find "$project_dir/config" -type f -print0)

exec 9>"$lock_file"
flock 9

compose() {
  local selected_release_env="$1"
  shift
  DOCKER_CONFIG="$docker_config" docker compose \
    --project-name stugu \
    --project-directory "$project_dir" \
    --env-file "$local_env" \
    --env-file "$selected_release_env" \
    --file "$project_dir/docker-compose.yml" \
    "$@"
}

release_image_matches() {
  local candidate="$1"
  local key="$2"
  local expected="$3"
  [[ "$(grep -c "^${key}=" "$candidate")" -eq 1 ]] || return 1
  local value digest
  value="$(sed -n "s/^${key}=//p" "$candidate")"
  digest="${value#"$expected@sha256:"}"
  [[ "$value" == "$expected@sha256:$digest" && "$digest" =~ ^[0-9a-f]{64}$ ]]
}

valid_ui_release() {
  local candidate="$1"
  [[ -f "$candidate" && ! -L "$candidate" ]] || return 1
  [[ "$(wc -l < "$candidate")" -eq 11 ]] || return 1
  local version
  version="$(sed -n 's/^STUGA_VERSION=//p' "$candidate")"
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] \
    && grep -Fxq "STUGA_RELEASE_ENV_SCHEMA=3" "$candidate" \
    && grep -Fxq "STUGA_UPDATE_AGENT_CONTRACT=3" "$candidate" \
    && grep -Fxq "STUGA_COMPOSE_CONTRACT=2" "$candidate" \
    && [[ "$(grep -c '^STUGA_VERSION=' "$candidate")" -eq 1 ]] \
    && release_image_matches "$candidate" STUGA_API_IMAGE \
      "${image_prefix}-api:v$version" \
    && release_image_matches "$candidate" STUGA_WEB_IMAGE \
      "${image_prefix}-web:v$version" \
    && release_image_matches "$candidate" STUGA_BACKUP_IMAGE \
      "${image_prefix}-backup:v$version" \
    && release_image_matches "$candidate" STUGA_TAPO_RUNNER_IMAGE \
      "${image_prefix}-tapo-export-runner:v$version" \
    && release_image_matches "$candidate" STUGA_UPDATE_AGENT_IMAGE \
      "${image_prefix}-update-agent:v$version" \
    && release_image_matches "$candidate" STUGA_MQTT_IMAGE \
      "${image_prefix}-mqtt:v$version" \
    && release_image_matches "$candidate" STUGA_NEXUS433_IMAGE \
      "${image_prefix}-nexus433:v$version"
}

valid_legacy_release() {
  local candidate="$1"
  [[ -f "$candidate" && ! -L "$candidate" ]] || return 1
  [[ "$(wc -l < "$candidate")" -eq 6 ]] || return 1
  local version api_image legacy_prefix
  version="$(sed -n 's/^STUGA_VERSION=//p' "$candidate")"
  api_image="$(sed -n 's/^STUGA_API_IMAGE=//p' "$candidate")"
  legacy_prefix="${api_image%"-api:v$version"}"
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] \
    && [[ "$legacy_prefix" =~ ^ghcr\.io/[a-z0-9_.-]{1,100}/[a-z0-9_.-]{1,100}$ ]] \
    && [[ "$(grep -c '^STUGA_VERSION=' "$candidate")" -eq 1 ]] \
    && [[ "$(grep -c '^STUGA_API_IMAGE=' "$candidate")" -eq 1 ]] \
    && [[ "$(grep -c '^STUGA_WEB_IMAGE=' "$candidate")" -eq 1 ]] \
    && [[ "$(grep -c '^STUGA_BACKUP_IMAGE=' "$candidate")" -eq 1 ]] \
    && [[ "$(grep -c '^STUGA_TAPO_RUNNER_IMAGE=' "$candidate")" -eq 1 ]] \
    && [[ "$(grep -c '^STUGA_UPDATE_AGENT_IMAGE=' "$candidate")" -eq 1 ]] \
    && grep -Fxq "STUGA_API_IMAGE=${legacy_prefix}-api:v$version" "$candidate" \
    && grep -Fxq "STUGA_WEB_IMAGE=${legacy_prefix}-web:v$version" "$candidate" \
    && grep -Fxq "STUGA_BACKUP_IMAGE=${legacy_prefix}-backup:v$version" "$candidate" \
    && grep -Fxq "STUGA_TAPO_RUNNER_IMAGE=${legacy_prefix}-tapo-export-runner:v$version" "$candidate" \
    && grep -Fxq "STUGA_UPDATE_AGENT_IMAGE=${legacy_prefix}-update-agent:v$version" "$candidate"
}

archive_legacy_release() {
  local candidate="$1"
  local label="$2"
  local archive="${candidate}.legacy-v1"
  if [[ -e "$archive" ]]; then
    echo "Refusing to replace existing legacy $label archive: $archive" >&2
    exit 1
  fi
  mv -- "$candidate" "$archive"
  chown "$appliance_user:$appliance_user" "$archive"
  chmod 0640 "$archive"
  echo "Preserved legacy $label at $archive"
}

release_version() {
  sed -n 's/^STUGA_VERSION=//p' "$1" | tail -n 1
}

start_release() {
  local selected_release_env="$1"

  # A power loss can interrupt PostgreSQL after the administrator is created
  # but before the entrypoint creates the application role. Bring up the
  # archive first and idempotently reconcile both roles before starting API
  # containers that depend on them.
  compose "$selected_release_env" up \
    --detach \
    --no-build \
    --pull never \
    --wait \
    --wait-timeout 600 \
    runtime-secrets \
    timescaledb
  compose "$selected_release_env" --profile maintenance run \
    --rm \
    --no-deps \
    timeseries-credential-reconcile

  compose "$selected_release_env" up \
    --detach \
    --no-build \
    --pull never \
    --remove-orphans \
    --wait \
    --wait-timeout 600
}

if ! valid_ui_release "$release_env"; then
  echo "Factory release environment is incompatible or does not pin image digests" >&2
  exit 1
fi
if [[ -e "$known_good_env" ]] && ! valid_ui_release "$known_good_env"; then
  if valid_legacy_release "$known_good_env"; then
    archive_legacy_release "$known_good_env" "known-good release"
  else
    echo "Known-good release environment is invalid" >&2
    exit 1
  fi
fi
selected_release_env="$release_env"
if [[ -e "$update_release_env" ]]; then
  if valid_ui_release "$update_release_env"; then
    selected_release_env="$update_release_env"
  elif valid_legacy_release "$update_release_env"; then
    archive_legacy_release "$update_release_env" "candidate release"
  else
    echo "Candidate release environment is incompatible or does not pin image digests" >&2
    exit 1
  fi
fi

echo "Pulling the pinned Stugu release"
if ! compose "$selected_release_env" pull; then
  echo "Registry pull failed; attempting to use already-cached images" >&2
fi

if start_release "$selected_release_env"; then
  install -m 0640 -o "$appliance_user" -g "$appliance_user" \
    "$selected_release_env" "$known_good_env"
  {
    printf 'version=%s\n' "$(release_version "$selected_release_env")"
    printf 'healthy_at=%s\n' "$(date --utc +%Y-%m-%dT%H:%M:%SZ)"
  } > "$status_file"
  chown "$appliance_user:$appliance_user" "$status_file"
  chmod 0640 "$status_file"
  echo "Stugu $(release_version "$selected_release_env") is healthy"
  exit 0
fi

echo "The new release did not become healthy" >&2
if valid_ui_release "$known_good_env" \
    && ! cmp --silent "$selected_release_env" "$known_good_env"; then
  echo "Restoring the last known-good application containers" >&2
  if start_release "$known_good_env"; then
    printf 'failed_version=%s\nrolled_back_at=%s\n' \
      "$(release_version "$selected_release_env")" "$(date --utc +%Y-%m-%dT%H:%M:%SZ)" \
      > "$status_file"
    chown "$appliance_user:$appliance_user" "$status_file"
    chmod 0640 "$status_file"
    echo "The last known-good application release is running" >&2
    exit 0
  fi
fi

exit 1
