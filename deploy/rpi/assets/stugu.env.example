# Persistent Raspberry Pi appliance settings. Run `stuguctl config` to edit.
# Container versions are pinned separately by each signed/hashed OS release.

# The appliance is available on its trusted LAN and Tailscale addresses.
# First-owner creation still requires the device-specific `stuguctl access`
# link generated during first boot.
BIND_ADDRESS=0.0.0.0
APP_PORT=8080

# Set true only before the first start if you want disposable demo data.
MOCK_ENABLED=false
STUGBY_NODE_NAME=Stugu
STUGBY_SYNC_INTERVAL_MS=15000

# CPU-heavy derived analysis is available but dormant until it is governed.
# Raw telemetry continues to be collected while these switches are false.
SPATIAL_LAYERS_ENABLED=false
SPATIAL_LAYERS_DATABASE_PATH=/app/data/experimental-spatial-layers.sqlite
SPATIAL_LAYERS_INTERVAL_MS=60000
SPATIAL_LAYERS_RETENTION_DAYS=30
DAILY_ANALYTICS_FINDINGS_ENABLED=false
SENSOR_GAP_RECOVERY_ENABLED=false

# Direct Gree/Wilfa heat-pump monitoring. Stugu can infer a common /24 broadcast
# from known local integrations; otherwise set the physical LAN broadcast when
# container discovery cannot see it (for example 192.168.1.255).
GREE_DISCOVERY_TARGETS=
GREE_POLL_INTERVAL_MS=60000

# Optional private bug-report relay. Put its shared secret in the protected
# bug-report directory as `relay-token`, then set the deployed HTTPS URL here.
BUG_REPORT_RELAY_URL=

# Optional Dropbox / Google Drive export destinations: the public IDs of a
# Dropbox app and a Google "TVs and Limited Input devices" OAuth client. See
# docs/cloud-export-destinations.md. Empty hides that destination.
STUGU_DROPBOX_APP_KEY=
STUGU_GOOGLE_DRIVE_CLIENT_ID=
STUGU_GOOGLE_DRIVE_CLIENT_SECRET=

# Keep all bind-mounted state on the A/B shared persistent partition.
STUGA_CONFIG_DIRECTORY=/persistent/stugu/config
STUGA_BACKUP_DIRECTORY=/persistent/stugu/backups
STUGA_MIGRATION_DIRECTORY=/persistent/stugu/migrations
STUGA_MIGRATION_SETTINGS_DIRECTORY=/persistent/stugu
STUGA_MIGRATION_ENV_FILENAME=stugu.env
STUGA_MIGRATION_SEED_RETENTION_DAYS=14
STUGA_MIGRATION_MAX_RETAINED_SEEDS=4
STUGA_UPDATE_OPERATIONS_DIRECTORY=/persistent/stugu/update-operations
STUGA_UPDATE_RELEASE_DIRECTORY=/persistent/stugu/update-release
STUGA_HOST_UPDATE_DIRECTORY=/persistent/stugu/host-update
STUGA_UPDATE_COMPOSE_ENV_FILE=/persistent/stugu/stugu.env
STUGA_STORAGE_ALLOWED_ROOTS=/persistent/stugu,/mnt/stugu,/media/stugu,/srv/stugu-storage
STUGA_DOCKER_CONFIG_DIRECTORY=/persistent/stugu/docker-config
STUGA_COMPOSE_PROJECT_NAME=stugu
STUGA_APNS_SECRET_DIR=/persistent/stugu/secrets/apns
STUGA_BUG_REPORT_SECRET_DIR=/persistent/stugu/secrets/bug-report
STUGA_CLOUDFLARE_SECRET_DIR=/persistent/stugu/secrets/cloudflare
STUGA_CLOUDFLARE_ENV_FILE=/persistent/stugu/secrets/cloudflare/config.env
STUGA_R2_SECRET_DIR=/persistent/stugu/secrets/r2
TAPO_HISTORY_API_SECRET_DIR=/persistent/stugu/secrets/tapo-history-api
TAPO_HISTORY_RUNNER_SECRET_DIR=/persistent/stugu/secrets/tapo-history-runner
TAPO_RUNNER_FLOW_FILE=/persistent/stugu/config/tapo-flow.json

# The appliance update agent is enabled by default. Add optional profiles with
# commas, for example: self-update,cloudflare,r2-backup,tapo-history
COMPOSE_PROFILES=self-update
SYSTEM_UPDATE_RUNTIME=raspberry-pi
SYSTEM_UPDATE_REPOSITORY=liljestk/open-stuga
SYSTEM_UPDATE_IMAGE_PREFIX=ghcr.io/liljestk/open-stuga

# Optional encrypted off-site recovery copies. Configure these together and add
# r2-backup to COMPOSE_PROFILES only after installing the three secret files.
STUGU_R2_ENDPOINT=
STUGU_R2_BUCKET=
STUGU_R2_PREFIX=stugu
STUGU_R2_POLL_INTERVAL_SECONDS=60
STUGU_R2_RETRY_INTERVAL_MINUTES=15

# Same-origin LAN and Tailscale use needs no CORS override. Add exact origins
# only for separately hosted browser clients.
CORS_ORIGIN=
# Generated once on the persistent partition during first boot. Do not reuse a
# bootstrap value from another appliance image.
LOCAL_AUTH_BOOTSTRAP_SECRET=
