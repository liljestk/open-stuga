    },
    "monitoring.advisory" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Monitoring insights support household checks; they do not replace safety alarms, physical inspection, or professional advice." } },
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "Seurantahavainnot tukevat kodin tarkastamista, mutta eivät korvaa turvahälyttimiä, fyysistä tarkastusta tai ammattilaisen arviota." } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Övervakningsinsikter stöder kontroller av hemmet men ersätter inte säkerhetslarm, fysisk inspektion eller professionell rådgivning." } }
      }
    },
    "monitoring.availability.server-upgrade-required.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Update Stugu Server to use server-authoritative Home monitoring." } },
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "Päivitä Stugu-palvelin, jotta palvelimen tuottama kodin seuranta voidaan ottaa käyttöön." } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Uppdatera Stugu-servern för att använda serverbaserad övervakning av hemmet." } }
      }
    },
    "monitoring.availability.server-upgrade-required.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Server upgrade required" } },
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "Palvelin on päivitettävä" } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Servern måste uppdateras" } }
      }
    },
    "monitoring.availability.unavailable.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Reconnect or refresh to retrieve the server monitoring result." } },
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "Yhdistä uudelleen tai päivitä näkymä hakeaksesi palvelimen seurantatuloksen." } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Anslut igen eller uppdatera för att hämta serverns övervakningsresultat." } }
