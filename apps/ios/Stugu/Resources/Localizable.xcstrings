    "The app talks directly to your selected Stugu server. It does not copy telemetry to an intermediary service." : {
      "comment" : "A description of the privacy policy of the app.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovellus on suoraan yhteydessä valitsemaasi Stugu-palvelimeen. Se ei kopioi telemetriatietoja välityspalveluun."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen kommunicerar direkt med den valda Stugu-servern. Den kopierar inte telemetri till en mellanliggande tjänst."
          }
        }
      }
    },
    "The condition persisted for %@ before the alert opened." : {
      "comment" : "A sentence that describes the duration of a condition. The argument is the string “%arg hr”, the string “%arg min”, or the string “%arg sec”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilanne jatkui %@ ennen hälytyksen avaamista."
          }
        },
