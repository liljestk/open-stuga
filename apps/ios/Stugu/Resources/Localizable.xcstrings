        "fi" : { "stringUnit" : { "state" : "translated", "value" : "Pohjapiirros on vain luku -tilassa" } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Planritningen är skrivskyddad" } }
      }
    },
    "Room scanning requires an online session so Stugu can verify the target floor before capture." : {
      "localizations" : {
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "Huoneskannaus vaatii verkkoyhteyden, jotta Stugu voi tarkistaa kohdekerroksen ennen kuvausta." } },
