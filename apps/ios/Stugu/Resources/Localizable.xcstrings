        "sv" : { "stringUnit" : { "state" : "translated", "value" : "Anslutningen bröts. Exportera skanningen eller anslut igen före import." } }
      }
    },
    "This Home is now read-only. The scan can still be exported, but it cannot be imported." : {
      "localizations" : {
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "Tämä koti on nyt vain luku -tilassa. Skannauksen voi silti viedä, mutta sitä ei voi tuoda." } },
