    "Your password is not stored. The server session is kept in the system cookie store until you sign out, disconnect, or the session expires." : {
      "comment" : "A description of the privacy of the app.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salasanaasi ei tallenneta. Palvelinistunto säilyy järjestelmän evästevarastossa, kunnes kirjaudut ulos, katkaiset yhteyden tai istunto vanhenee."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt lösenord lagras inte. Serversessionen sparas i systemets cookie-arkiv tills du loggar ut, kopplar bort eller sessionen löper ut."
          }
        }
      }
    },
    "Your password is used only for this sign-in request and is never saved by the app." : {
