{
  "name": "@climate-twin/web",
  "version": "0.42.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "test": "vitest run --configLoader runner --testTimeout=10000",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov --configLoader runner --testTimeout=10000",
    "test:watch": "vitest --configLoader runner",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@climate-twin/contracts": "0.42.0",
    "@climate-twin/spatial-layers": "0.42.0",
    "@climate-twin/stuguby-protocol": "0.42.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@tanstack/react-query": "5.101.4",
    "@vitejs/plugin-react": "^6.0.4",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.24.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "jsdom": "^25.0.1",
    "vite": "^8.1.6",
    "vitest": "^4.1.11"
  }
}
