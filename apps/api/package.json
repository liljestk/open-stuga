{
  "name": "@climate-twin/api",
  "version": "0.52.9",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "cd ../.. && tsx watch --env-file-if-exists=.env apps/api/src/index.ts",
    "start": "cd ../.. && node --env-file-if-exists=.env apps/api/dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov --maxWorkers=4",
    "test:watch": "vitest",
    "mcp": "cd ../.. && tsx --env-file-if-exists=.env apps/api/src/mcp-server.ts",
    "mcp:chatgpt": "cd ../.. && tsx --env-file-if-exists=.env apps/api/src/chatgpt-mcp-server.ts"
  },
  "dependencies": {
    "@climate-twin/analytics-kernel": "*",
    "@climate-twin/contracts": "*",
    "@climate-twin/spatial-layers": "*",
    "@climate-twin/stuguby-protocol": "*",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "bonjour-service": "^1.4.3",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.11.1",
    "mqtt": "5.15.2",
    "pg": "8.22.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/express": "^5.0.3",
    "@types/node": "22.13.14",
    "@types/pg": "8.20.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.12",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12"
  }
}
