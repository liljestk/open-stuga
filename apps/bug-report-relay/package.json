{
  "name": "@climate-twin/bug-report-relay",
  "version": "0.41.17",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "pretypes": "node -e \"require('node:fs').mkdirSync('.wrangler', { recursive: true })\"",
    "types": "wrangler types .wrangler/worker-configuration.d.ts",
    "typecheck": "npm run types && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --configLoader runner"
  },
  "dependencies": {
    "@climate-twin/contracts": "0.41.17"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.120.0"
  }
}
