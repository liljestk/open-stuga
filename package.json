{
  "name": "climate-twin",
  "version": "0.43.0",
  "private": true,
  "license": "MIT",
  "description": "A local-first digital twin for extensible whole-home environmental telemetry.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build:analytics-kernel": "npm run build --workspace @climate-twin/analytics-kernel",
    "build:contracts": "npm run build --workspace @climate-twin/contracts",
    "build:spatial-layers": "npm run build --workspace @climate-twin/spatial-layers",
    "build:stuguby-protocol": "npm run build --workspace @climate-twin/stuguby-protocol",
    "build:packages": "npm run build:analytics-kernel && npm run build:contracts && npm run build:spatial-layers && npm run build:stuguby-protocol",
    "build:nexus433-source": "node scripts/build-nexus433-source-bundle.mjs",
    "build:host-bundle": "node scripts/build-host-update-bundle.mjs",
    "verify:host-publication": "python scripts/verify-host-tuf-publication.py",
    "verify:local": "node scripts/verify-local.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "rpi:doctor": "node scripts/rpi-doctor.mjs",
    "dev": "npm run build:packages && concurrently -k -n api,web -c blue,green \"npm run dev --workspace @climate-twin/api\" \"npm run dev --workspace @climate-twin/web\"",
    "dev:api": "npm run build:packages && npm run dev --workspace @climate-twin/api",
    "dev:web": "npm run build:packages && npm run dev --workspace @climate-twin/web",
    "build": "npm run build:packages && npm run build --workspace @climate-twin/api && npm run build --workspace @climate-twin/web",
    "ci:local": "node scripts/local-ci.mjs",
    "test": "npm run build:packages && npm run test --workspaces --if-present && npm run test:tooling",
    "test:tooling": "npm run test:lean-tooling && npm run test:code-quality && npm run test:setup && npm run test:native-readiness && npm run test:data-safety && npm run test:r2-backup && npm run test:live-migration && npm run test:cloudflare && npm run test:rpi-ota && npm run test:host-updater && npm run test:update-agent && npm run test:nexus433-runtime",
    "test:lean-tooling": "node --test scripts/tests/lean-tooling.test.mjs scripts/tests/visual-evidence.test.mjs scripts/tests/api-healthcheck.test.mjs",
    "test:code-quality": "node --test scripts/tests/code-quality-gates.test.mjs",
    "test:setup": "node --test scripts/tests/setup.test.mjs scripts/tests/setup.part-02.test.mjs scripts/tests/cloudflare-oauth.test.mjs scripts/tests/local-ci.test.mjs",
    "test:native-readiness": "node --test apps/ios/Tests/native-readiness.test.mjs",
    "test:data-safety": "node --test scripts/tests/data-safety.test.mjs scripts/tests/data-safety.part-02.test.mjs scripts/tests/remove-stuguby-connection.test.mjs scripts/tests/scheduled-data-export-worker.test.mjs",
    "test:r2-backup": "node --test scripts/tests/r2-backup.test.mjs",
    "test:live-migration": "node --test scripts/tests/live-migration.test.mjs scripts/tests/live-migration.part-02.test.mjs",
    "test:cloudflare": "node --test scripts/tests/cloudflare-stugu.test.mjs",
    "cloudflare:provision": "node scripts/cloudflare-stugu.mjs provision",
    "cloudflare:provision-coordinator": "node scripts/setup.mjs --cloudflare coordinator",
    "cloudflare:provision-coordinator:advanced": "node scripts/cloudflare-stugu.mjs provision-coordinator",
    "cloudflare:verify": "node scripts/cloudflare-stugu.mjs verify",
    "cloudflare:verify-coordinator": "node scripts/cloudflare-stugu.mjs verify-coordinator",
    "stuguby:remove": "node scripts/remove-stuguby-connection.mjs",
    "test:rpi-ota": "node --test scripts/tests/rpi-ota.test.mjs scripts/tests/host-release-contract.test.mjs scripts/tests/rpi-tailscale.test.mjs",
    "test:host-updater": "python -m unittest discover -s deploy/rpi/host-updater/tests -t deploy/rpi/host-updater -v",
    "test:update-agent": "node --test scripts/tests/system-update-agent.test.mjs scripts/tests/host-update-agent-interlock.test.mjs scripts/tests/update-agent-process-safety.test.mjs scripts/tests/update-agent-service.test.mjs scripts/tests/source-profile-agent.test.mjs scripts/tests/storage-agent.test.mjs",
    "test:nexus433-runtime": "node --test scripts/tests/nexus433-runtime.test.mjs",
    "update-agent": "node --env-file-if-exists=.env scripts/stugu-update-agent.mjs",
    "update-agent:service:install": "node scripts/stugu-update-agent-service.mjs install",
    "update-agent:service:uninstall": "node scripts/stugu-update-agent-service.mjs uninstall",
    "test:coverage": "npm run build:packages && npm run test:coverage --workspaces --if-present",
    "test:coverage:python": "python -m pytest apps/api/python_tests --cov=apps/api/python --cov-report=term-missing --cov-report=xml:apps/api/coverage-python.xml --cov-fail-under=80",
    "check:file-size": "node scripts/check-source-file-size.mjs",
    "check:architecture": "node scripts/check-architecture-boundaries.mjs",
    "check:unused": "node scripts/check-unused-symbols.mjs",
    "sonar:scan": "npx --yes --package=@sonar/scan@4.3.8 sonar",
    "sonar:gate": "npm run test:coverage && npm run test:coverage:python && npm run sonar:scan",
    "typecheck": "npm run check:file-size && npm run check:architecture && npm run build:packages && npm run typecheck --workspaces --if-present && npm run check:unused",
    "smoke:built-api": "node scripts/smoke-built-api.mjs",
    "smoke:nexus433": "node scripts/smoke-nexus433.mjs",
    "telemetry:migrate": "node scripts/migrate-telemetry-to-timescale.mjs",
    "backup": "node scripts/stugu-backup.mjs",
    "migrate": "node scripts/stugu-live-migrate.mjs",
    "version:check": "node scripts/check-version.mjs",
    "version:check-pr": "node scripts/check-version.mjs --require-base-bump",
    "release:local": "node scripts/publish-local-release.mjs",
    "mcp": "npm run build:packages && npm run mcp --workspace @climate-twin/api",
    "mcp:chatgpt": "npm run build:packages && npm run mcp:chatgpt --workspace @climate-twin/api",
    "tracking:simulate": "tsx apps/api/src/tracking/simulator.ts",
    "benchmark:home-performance": "node scripts/benchmark-home-performance.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "overrides": {
    "@types/node": "22.13.14",
    "@hono/node-server": "2.0.11",
    "fast-uri": "3.1.9",
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
    },
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.13.14",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^10.0.6",
    "typescript": "^5.8.3",
    "vite": "8.1.6",
    "vitest": "^4.1.12"
  }
}
